---
import { lokasi } from '../lib/content';
import MapSlot from './MapSlot.astro';
---

<section id="bab-1" class="relative w-full py-16 md:py-24 border-t border-line/40">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <!-- Chapter Header -->
    <div class="mb-8">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-ink">Lanskap & Peta Dua Perkebunan</h2>
      <p class="text-xs md:text-sm font-sans text-muted mt-2 max-w-2xl leading-relaxed">
        Orientasi letak Perkebunan Sumber Tenggulun di wilayah Jember bagian barat (Kecamatan Tanggul) dan Perkebunan Kali Jompo di lereng pegunungan Hyang Argopuro bagian timur (Kecamatan Sukorambi).
      </p>
    </div>

    <!-- MapSlot Component -->
    <MapSlot lokasi={lokasi} modelUrl={null} />

    <!-- Two Locations Summary Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-8">
      {lokasi.map((item) => (
        <article
          class="p-5 sm:p-6 border border-line bg-surface flex flex-col justify-between rounded-xl shadow-xs"
        >
          <div>
            <div class="flex items-center justify-between text-xs font-sans pb-2 border-b border-line/50">
              <span class="font-medium text-ink text-sm font-serif">{item.nama}</span>
              <span class={item.status_data === 'bersumber' ? 'text-accent font-medium text-[11px]' : 'text-muted italic text-[11px]'}>
                {item.status_data === 'bersumber' ? 'Data Bersumber' : 'Perlu Pemeriksaan'}
              </span>
            </div>
            <p class="text-[11px] font-sans text-muted mt-2">
              {item.desa}, {item.kecamatan}, {item.kabupaten} ({item.lereng})
            </p>
            <p class="text-xs font-serif text-ink/90 mt-2 leading-relaxed">
              {item.ringkasan}
            </p>
          </div>

          <div class="mt-4 pt-3 border-t border-line/30 flex items-center justify-between text-[11px] font-sans">
            <span class="text-muted">Komoditas: {item.komoditas_awal.join(', ')}</span>
            <a
              href={item.id === 'kali-jompo' ? '#bab-2' : '#bab-3'}
              class="min-h-[32px] inline-flex items-center text-accent hover:text-ink font-medium border-b border-accent/40 hover:border-ink transition-colors"
            >
              Baca Telaah {item.id === 'kali-jompo' ? 'Kali Jompo' : 'Sumber Tenggulun'} →
            </a>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>


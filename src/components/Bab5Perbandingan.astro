---
import { perbandingan } from '../lib/content';
import RefMarker from './RefMarker.astro';
import ContourDivider from './ContourDivider.astro';
---

<section id="bab-5" class="relative w-full py-16 md:py-24 border-t border-line/40">
  <div class="max-w-6xl mx-auto px-4 md:px-8">
    <!-- Chapter Header -->
    <div class="mb-10">
      <span class="text-xs font-sans tracking-widest uppercase text-muted">Bab 5 / Sintesis Komparatif</span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-serif text-ink mt-1">{perbandingan.judul}</h2>
      <p class="text-xs md:text-sm font-sans text-muted mt-2 max-w-2xl leading-relaxed">
        {perbandingan.keterangan}
      </p>
    </div>

    <!-- Typographic Comparison Table (PRD Section 5 & Lampiran A4) -->
    <div class="border border-line bg-surface overflow-x-auto" style="border-radius: var(--radius-sm);">
      <table class="w-full text-left border-collapse min-w-[640px]">
        <thead>
          <tr class="border-b border-line bg-surface/90 text-xs font-sans text-muted uppercase tracking-wider">
            <th class="py-3.5 px-4 md:px-6 w-1/4">Aspek Perbandingan</th>
            <th class="py-3.5 px-4 md:px-6 w-3/8 border-l border-line/60">
              <span class="text-ink font-semibold">Kali Jompo</span>
              <span class="block text-[11px] font-normal normal-case text-muted">Desa Klungkung, Sukorambi</span>
            </th>
            <th class="py-3.5 px-4 md:px-6 w-3/8 border-l border-line/60">
              <span class="text-ink font-semibold">Sumber Tenggulun</span>
              <span class="block text-[11px] font-normal normal-case text-muted">Desa Manggisan, Tanggul</span>
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line/40 text-xs font-sans text-ink">
          {perbandingan.aspek.map((item) => (
            <tr class="hover:bg-ground/50 transition-colors">
              <td class="py-4 px-4 md:px-6 font-medium text-ink/90 align-top">
                {item.nama}
                {item.status === 'perlu_pemeriksaan' && (
                  <span class="block text-[10px] text-muted border-b border-dashed border-line w-max mt-1">
                    Perlu Pemeriksaan
                  </span>
                )}
              </td>
              <td class="py-4 px-4 md:px-6 border-l border-line/40 text-ink/80 align-top leading-relaxed">
                {item.kali_jompo}
                {item.kali_jompo_sumber_ids && item.kali_jompo_sumber_ids.map((sId: string) => (
                  <RefMarker id={sId} />
                ))}
              </td>
              <td class="py-4 px-4 md:px-6 border-l border-line/40 text-ink/80 align-top leading-relaxed">
                {item.sumber_tenggulun}
                {item.sumber_tenggulun_sumber_ids && item.sumber_tenggulun_sumber_ids.map((sId: string) => (
                  <RefMarker id={sId} />
                ))}
                {item.catatan && (
                  <span class="block text-[11px] text-muted italic mt-1.5 pt-1 border-t border-line/20">
                    * {item.catatan}
                  </span>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Data Chart Placeholder: "Data Belum Tersedia" State (PRD Section 5) -->
    <div class="mt-8 border border-line border-dashed bg-surface/50 p-6 md:p-8 text-center" style="border-radius: var(--radius-sm);">
      <div class="max-w-md mx-auto space-y-2">
        <span class="text-[11px] font-sans tracking-widest uppercase text-muted">Slot Grafik Deret Waktu Produksi</span>
        <h3 class="text-base font-serif text-ink">Visualisasi Volume Panen & Produktivitas</h3>
        <p class="text-xs font-sans text-muted leading-relaxed">
          Kondisi saat ini: <em>Data statistik deret waktu produksi kopi tahunan belum tersedia</em>. Komponen grafik dirancang siap menerima data agregat resmi dari arsip primer FIB saat angka telah terverifikasi.
        </p>
        <div class="pt-3 flex items-center justify-center gap-4 text-[11px] font-sans text-muted">
          <span class="tabular">Satuan: Ton / Hektare [ISI DARI FIB]</span>
          <span>·</span>
          <span>Deret Tahun: [ISI DARI FIB]</span>
        </div>
      </div>
    </div>
  </div>

  <ContourDivider label="Data Lahan & Komoditas" />
</section>

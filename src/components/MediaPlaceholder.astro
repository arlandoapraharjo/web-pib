---
import { getMediaById } from '../lib/content';

interface Props {
  id: string;
  class?: string;
  showCaption?: boolean;
}

const { id, class: className = '', showCaption = true } = Astro.props;
const item = getMediaById(id);

if (!item) {
  throw new Error(`MediaSlot with id "${id}" not found in media.json`);
}

// Map ratio string to Tailwind aspect ratio
const ratioClasses: Record<string, string> = {
  '16:9': 'aspect-[16/9]',
  '4:3': 'aspect-[4/3]',
  '3:2': 'aspect-[3/2]',
  '4:5': 'aspect-[4/5]',
  '1:1': 'aspect-square',
};

const aspectClass = ratioClasses[item.rasio] || 'aspect-[16/9]';
---

<!-- Physical Dossier Folder Card (Compact archival scale, 0-4px radius, 3D bottom hinge & fanning sheet) -->
<figure class={`media-slot-container group flex flex-col cursor-pointer ${className}`}>
  <!-- Folder Tab Header -->
  <div class="flex items-center justify-between text-[9px] sm:text-[10px] font-sans text-muted mb-[-1px] z-10 pl-2">
    <div
      class="px-2.5 py-0.5 sm:py-1 bg-surface border-t border-x border-line/70 flex items-center gap-1.5 transition-colors group-hover:border-accent group-hover:bg-ground"
      style="border-radius: var(--radius-sm) var(--radius-sm) 0 0;"
    >
      <span class="w-1.5 h-1.5 bg-contour inline-block" style="border-radius: 1px;"></span>
      <span class="tabular font-medium text-ink tracking-wider">BERKAS #{item.id}</span>
    </div>
    <span class="pr-2 tabular text-muted/70 text-[9px]">RASIO {item.rasio}</span>
  </div>

  <!-- 3D Folder Shell with Perspective -->
  <div
    class={`relative w-full overflow-hidden border border-line/70 bg-surface/90 flex flex-col justify-between p-3 sm:p-4 md:p-5 transition-all duration-400 group-hover:border-accent/90 group-hover:shadow-[0_8px_24px_rgb(0,0,0,0.05)] dark:group-hover:shadow-[0_8px_24px_rgb(0,0,0,0.2)] ${aspectClass}`}
    style="border-radius: var(--radius-sm); perspective: 900px;"
  >
    <!-- Background Archival Grid / Contour watermark -->
    <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.05] pointer-events-none" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id={`grid-${item.id}`} width="18" height="18" patternUnits="userSpaceOnUse">
            <path d="M 18 0 L 0 0 0 18" fill="none" stroke="currentColor" stroke-width="0.5" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill={`url(#grid-${item.id})`} />
      </svg>
    </div>

    {item.berkas ? (
      <img
        src={item.berkas}
        alt={item.alt}
        loading="lazy"
        decoding="async"
        class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      />
    ) : (
      <!-- Inside Fanning Archival Document Sheet -->
      <div
        class="relative z-10 w-full h-full flex flex-col justify-between text-muted select-none transition-transform duration-500 ease-out group-hover:-translate-y-1.5 group-hover:rotate-[-0.5deg]"
      >
        <!-- Top Metadata Row -->
        <div class="flex items-center justify-between text-[10px] font-sans pb-1.5 border-b border-line/40">
          <span class="text-accent font-medium tracking-wide">DOKUMEN HISTORIS RESMI</span>
          <span
            class="text-[9px] border border-line/60 px-1.5 py-0.5 text-muted/90 bg-ground/80"
            style="border-radius: var(--radius-sm);"
          >
            Menunggu Berkas
          </span>
        </div>

        <!-- Central Content Body -->
        <div class="my-auto py-1 sm:py-2">
          <p class="text-[11px] sm:text-xs font-serif italic text-ink/90 leading-relaxed max-w-sm line-clamp-3">
            {item.keterangan}
          </p>
          <p class="text-[10px] font-sans text-secondary mt-1.5 flex items-center gap-1.5 font-medium">
            <span class="inline-block w-1 h-1 bg-secondary" style="border-radius: 1px;"></span>
            <span>Verifikasi izin arsip Program Studi Sejarah UNEJ</span>
          </p>
        </div>

        <!-- Bottom Sheet Footer -->
        <div class="pt-1.5 border-t border-line/40 flex items-center justify-between text-[9px] font-sans text-muted">
          <span>Atribusi: Tim Riset Sejarah</span>
          <span class="italic text-muted/70">Format: WebP</span>
        </div>
      </div>
    )}

    <!-- Physical Front Folder Flap (3D Bottom Hinge) -->
    <div
      class="absolute inset-x-0 bottom-0 h-[34%] pointer-events-none transition-transform duration-500 ease-out origin-bottom border-t border-line/60 bg-surface/95 flex flex-col justify-between p-2.5 sm:p-3 group-hover:[transform:rotateX(-20deg)] group-hover:opacity-90 shadow-[0_-3px_8px_rgb(0,0,0,0.02)]"
      style="transform-style: preserve-3d;"
      aria-hidden="true"
    >
      <div class="flex items-center justify-between text-[8px] sm:text-[9px] font-sans text-muted/80 tracking-widest uppercase">
        <span>Arsip Kurasi</span>
        <span class="tabular">REF: {item.id}</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="h-[1px] flex-1 bg-line/40"></div>
        <span class="text-[8px] font-sans tracking-widest text-muted/60 uppercase">Dossier</span>
        <div class="h-[1px] flex-1 bg-line/40"></div>
      </div>
    </div>
  </div>

  {showCaption && (
    <figcaption class="mt-1.5 text-left text-[10px] sm:text-[11px] font-sans text-muted leading-normal flex items-baseline justify-between gap-2">
      <span class="group-hover:text-ink transition-colors line-clamp-1">{item.alt}</span>
      <span class="shrink-0 tabular text-[9px] sm:text-[10px]">Bab {item.bab}</span>
    </figcaption>
  )}
</figure>

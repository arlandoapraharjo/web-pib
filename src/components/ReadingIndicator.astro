---
// Fixed Reading Indicator (Clean 2px Top Contour Progress Bar, No Floating Pill Badges)
---

<!-- Top Viewport Thin Progress Bar (Fixed across all devices, zero layout collision) -->
<div class="fixed top-0 left-0 right-0 h-[2px] z-50 pointer-events-none" aria-hidden="true">
  <div
    id="reading-top-bar"
    class="h-full bg-accent transition-all duration-100 ease-out"
    style="width: 0%;"
  ></div>
</div>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const topBar = document.getElementById('reading-top-bar');
    if (!topBar) return;

    function updateProgress() {
      const scrollTop = window.scrollY || document.documentElement.scrollTop;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
      topBar.style.width = `${progress}%`;
    }

    window.addEventListener('scroll', updateProgress, { passive: true });
    window.addEventListener('resize', updateProgress, { passive: true });
    updateProgress();
  });
</script>

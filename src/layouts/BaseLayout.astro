---
import '../styles/tokens.css';
import '../styles/base.css';
import NavHeader from '../components/NavHeader.astro';
import ReadingIndicator from '../components/ReadingIndicator.astro';
import RefPopover from '../components/RefPopover.astro';
import RefDrawer from '../components/RefDrawer.astro';
import { proyek } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${proyek.judul} — Sejarah Perkebunan Argopuro`,
  description = "Dokumentasi sejarah perkebunan kopi Kali Jompo dan Sumber Tenggulun di lereng Pegunungan Argopuro Jember.",
} = Astro.props;
---

<!doctype html>
<html lang="id" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    
    <!-- Canonical & Favicon (Addresses Jury Audit Finding) -->
    <link rel="canonical" href="http://127.0.0.1:4400/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Open Graph & Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon.svg" />
    <meta property="og:site_name" content={proyek.judul} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Google Fonts: Newsreader (Editorial Serif) & Inter (Humanist Sans) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&display=swap"
      rel="stylesheet"
    />

    <!-- Theme Initialization Script to prevent theme flashing -->
    <script is:inline>
      try {
        const theme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', theme);
      } catch (e) {}
    </script>
  </head>
  <body class="bg-ground text-ink min-h-screen relative antialiased selection:bg-accent selection:text-ground">
    <!-- Skip link is the very first focusable stop in DOM order (Addresses WCAG keyboard order) -->
    <a href="#main-content" class="skip-link">Lewati ke isi utama</a>

    <NavHeader />
    <ReadingIndicator />

    <main id="main-content" tabindex="-1">
      <slot />
    </main>

    <RefPopover />
    <RefDrawer />

    <!-- GSAP & Lenis Setup Script (Smooth Scroll Fixed by Default + Pinned Horizontal Scrub) -->
    <script>
      import Lenis from 'lenis';
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion) {
        // 1. Initialize Lenis Smooth Scroll by default
        const lenis = new Lenis({
          duration: 1.15,
          easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          smoothWheel: true,
        });

        (window as any).lenisInstance = lenis;

        lenis.on('scroll', ScrollTrigger.update);

        gsap.ticker.add((time) => {
          lenis.raf(time * 1000);
        });

        gsap.ticker.lagSmoothing(0);

        // 2. Animate hero contour drawing
        const heroContour = document.querySelector('.hero-contour-draw');
        if (heroContour) {
          gsap.fromTo(
            heroContour,
            { strokeDashoffset: 500 },
            {
              strokeDashoffset: 0,
              duration: 2.2,
              ease: 'power2.out',
            }
          );
        }

        const heroContourSec = document.querySelector('.hero-contour-draw-sec');
        if (heroContourSec) {
          gsap.fromTo(
            heroContourSec,
            { strokeDashoffset: 500 },
            {
              strokeDashoffset: 0,
              duration: 2.5,
              delay: 0.2,
              ease: 'power2.out',
            }
          );
        }

        // 3. Animate SVG contour lines in map slot when scrolled into view
        const contourLines = document.querySelectorAll('.contour-line');
        if (contourLines.length > 0) {
          gsap.from(contourLines, {
            scrollTrigger: {
              trigger: '#mapslot-root',
              start: 'top 80%',
            },
            strokeDashoffset: 600,
            duration: 1.8,
            stagger: 0.15,
            ease: 'power2.out',
          });
        }

        // 4. GSAP Pinned Horizontal Timeline Scroll (Seamless wheel/trackpad continuation)
        const timelineTrack = document.getElementById('timeline-scroll-track');
        const timelineWrapper = document.getElementById('timeline-pinned-wrapper');

        if (timelineTrack && timelineWrapper && window.innerWidth >= 768) {
          const getScrollDistance = () => {
            return timelineTrack.scrollWidth - window.innerWidth + 120;
          };

          gsap.to(timelineTrack, {
            x: () => -getScrollDistance(),
            ease: 'none',
            scrollTrigger: {
              trigger: timelineWrapper,
              start: 'top top',
              end: () => `+=${getScrollDistance() * 1.1}`,
              pin: true,
              scrub: 1,
              invalidateOnRefresh: true,
            },
          });
        }

        // 5. GSAP Scroll-Triggered Text Reveal and Card Reveal
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (!prefersReducedMotion) {
          // Kinetic Text Reveal
          const textRevealElements = document.querySelectorAll(
            'section h2, section p.max-w-2xl, section p.max-w-xl, .reveal-text'
          );
          textRevealElements.forEach((el) => {
            gsap.from(el, {
              scrollTrigger: {
                trigger: el,
                start: 'top 88%',
                toggleActions: 'play none none none',
              },
              y: 28,
              opacity: 0,
              duration: 0.85,
              ease: 'power3.out',
            });
          });

          // Kinetic Card Reveal
          const cardRevealElements = document.querySelectorAll(
            '.media-slot-container, .reveal-card, article'
          );
          cardRevealElements.forEach((card) => {
            gsap.from(card, {
              scrollTrigger: {
                trigger: card,
                start: 'top 85%',
                toggleActions: 'play none none none',
              },
              y: 35,
              scale: 0.97,
              opacity: 0,
              duration: 0.9,
              ease: 'power3.out',
            });
          });
        }
      }
    </script>
  </body>
</html>
